---
import './promo.css'
---

<section class="promo" style={`background-image: url('${import.meta.env.BASE_URL}/images/promo_bg.webp');`}>
  <div class="container promo__inner">
    <div class="promo__box" style={`background-image: url('${import.meta.env.BASE_URL}/images/promo.webp');`}>
      <div class="promo__content">
        <h2 class="title promo__title">KickScooter s1</h2>
          <div class="text-content promo__text">
            <p>
              Aliquam molestie pharetra ex, maximus lobortis metus varius sed. 
              Aenean at Proin rutrum ligula in ultrices aliquam
            </p>
          </div>
          <ul class="promo-feature">
            <li class="promo-features__item">Semi-auto Pilot</li>
            <li class="promo-features__item">Segway System</li>
            <li class="promo-features__item">Two-way Charging</li>
            <li class="promo-features__item">Low Operation</li>
          </ul>
      </div>
    </div>  
    
      <button class="promo__play" type="button" aria-label="Play promo Video">
        <span class="sr-only">Play promo Video</span>
      </button>
  </div>
</section>