---
import './sc-design.css';
---

<section class="sc-design" style={`background-image: url('${import.meta.env.BASE_URL}/images/sc-design_bg.webp');`}>
  <div class="container sc-design__inner text-center">
    <div class="sc-design__content">
      <h1 class="sc-design__title">Kick’s Scooter</h1>     
      <div class="text-content sc-design__text">
        <p>Designed in a minimal yet versatile form to solve
          the current safety and usability problems.
        </p>
      </div>
    </div>

  </div>
</section>