---
import './subscribe.css';
---

<section class="subscribe">
  <div class="container subscribe__inner">
    <h2 class="sr-only">subscribe</h2>
    <div class="subscribe__text">
      <p>
        Join the Movement. Located in more than
        100 cities worldwide.
      </p>
    </div>
    <form action="" class="subscribe-form">
      <label for="email" class="sr-only">Enter your name</label>
      <div class="subscribe-form__row">
        <input type="email" name="email" id="email" class="subscribe-form__input" required >
        <button type="submit" class="subscribe-form__btn" title="Submit">
          <span class="sr-only">Submit</span>
        </button>
      </div>
    </form>

  </div>
</section>