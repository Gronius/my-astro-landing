---
const { width, height

 } = Astro.props;
---

<a href="/" class="logo">
  <img class="logo-main" src={`${import.meta.env.BASE_URL}/images/logo.svg`} alt="KiksCo" width={width} height={height}>
  <img class="logo-fixed" src={`${import.meta.env.BASE_URL}/images/logo-white.svg`} alt="KiksCo" width="120" height="38">
</a>
