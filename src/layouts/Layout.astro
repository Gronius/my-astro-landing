---
import Header from "../components/Base/Header/Header.astro";
import Footer from "../components/Base/Footer/Footer.astro";
const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">


				<!-- <link rel="stylesheet" href="./../style.css"> -->
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<div class="wrapper">
			<Header />
			<slot />
			<Footer />	
		</div>

		<!-- Кнопка "Вгору" -->
<button class="back-to-top" id="backToTop" aria-label="Проскролити вгору" title="Вгору">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
  const backToTopBtn = document.getElementById('backToTop');

  const handleScroll = () => {
    // Показуємо кнопку, якщо проскролили більше ніж 400px
    if (window.scrollY > 400) {
      backToTopBtn?.classList.add('is-visible');
    } else {
      backToTopBtn?.classList.remove('is-visible');
    }
  };

  // Плавний скрол до самого верху при кліку
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });

  window.addEventListener('scroll', handleScroll);
</script>